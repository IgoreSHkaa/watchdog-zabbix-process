#=== Required variables ===

# IP or DNS name of the Zabbix server/proxy
ZABBIX_SERVER="{{ zabbix_server | default('127.0.0.1') }}"

# Host name in Zabbix (MUST match exactly with Zabbix UI)
ZABBIX_HOST="{{ zabbix_host | default(inventory_hostname) }}"

# Data item key in Zabbix
ZABBIX_KEY="{{ zabbix_key | default('process.watchdog.new.alert') }}"

#=== Optional variables (with safe defaults) ===

# Path to the state file
STATE_FILE="{{ state_file | default('/var/tmp/process_state.txt') }}"

# Path to the whitelist file
WHITELIST_FILE="{{ whitelist_file | default('/etc/process_whitelist.conf') }}"

# Path to the zabbix_sender utility
ZABBIX_SENDER="{{ zabbix_sender_path | default('/usr/sbin/zabbix_sender') }}"
